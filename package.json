{
  "name": "func-loc",
  "version": "0.1.16",
  "description": "Retrieve the function location from it reference in NodeJS.",
  "main": "./dist/index.js",
  "typings": "./dist/index.d.ts",
  "scripts": {
    "prepare": "husky",
    "test:tsc": "tsc --sourceMap __tests__/assets/*.ts",
    "build": "tsc --build tsconfig.json",
    "prebuild": "rimraf dist",
    "watch": "tsc -w",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"__tests__/**/*.js\"",
    "pretest": "npm run build && npm run lint",
    "test": "nyc --reporter=html --reporter=text mocha __tests__/**/*.test.js",
    "prepublishOnly": "npm test",
    "preversion": "npm run lint",
    "version": "npm run format && git add -A src",
    "postversion": "git push && git push --tags",
    "coverage": "nyc report --reporter=text-lcov"
  },
  "repository": {
    "url": "https://github.com/midrissi/func-loc.git",
    "type": "git"
  },
  "keywords": [
    "function",
    "location",
    "nodejs",
    "node",
    "inspector",
    "promise"
  ],
  "author": {
    "name": "Mohamed IDRISSI",
    "email": "med.idrissi@outlook.com",
    "url": "https://github.com/midrissi"
  },
  "license": "MIT",
  "dependencies": {
    "data-urls": "^5.0.0",
    "source-map": "^0.7.4",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "chai": "^5.1.2",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "mocha": "^11.0.1",
    "nyc": "^17.1.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "engines": {
    "node": ">= 8.0.0"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.ts",
    "dist/**/*.map"
  ],
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write",
      "git add"
    ]
  }
}
